PORT=5000
MONGO_URI=mongodb://localhost:27017/realestate
JWT_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30
CLIENT_ORIGIN=http://localhost:5173
# Multi-tenancy (resolveTenant middleware, see shared/middleware/resolveTenant.js)
PLATFORM_ROOT_DOMAIN=myplatform.com
DEFAULT_AGENCY_SLUG=dreamhomes
# AI Assistant (features/ai) runs fully offline by default - keyword/
# entity intent matching against MongoDB-backed tools (see
# ai/localEngine/). No API key or external provider required.
# Optional LLM escalation (Phase 3): only used when the deterministic
# engine's confidence is low. Leave all three unset and the app behaves
# exactly as if this section didn't exist. Any OpenAI-compatible endpoint
# works (e.g. Gemini's - https://generativelanguage.googleapis.com/v1beta/openai).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Email delivery (server/src/shared/notifications/emailProvider.js) - used
# for agency-invites-agent emails (agency.service.js's inviteUser). Leave
# all unset and invites are still created normally; the UI falls back to a
# "copy this link manually" flow instead of emailing it. Any standard SMTP
# provider works (e.g. a Gmail account + App Password, SendGrid/Mailgun/
# Postmark's SMTP relay, etc.) - set all of SMTP_HOST/SMTP_USER/SMTP_PASS to
# enable real delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
